# ==========================================
# CONFIGURAÇÕES DO FIREBASE & CAKTO — CORNER
# ==========================================

# 1. Firebase Web App (Console Firebase > Configurações do Projeto)
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto-id
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef

# 2. Cakto
VITE_CAKTO_CHECKOUT_URL=https://cakto.com.br/checkout/...
VITE_CAKTO_WEBHOOK_SECRET=seu_token_secreto_cakto

# 3. Google Gemini (Opcional para IA)
VITE_GEMINI_API_KEY=
